<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
	  Name="mde"
	  Manufacturer="tanno-seiichi"
	  Version="1.4.0"
	  UpgradeCode="{AF84DAC2-4F15-4286-9979-7694751AAA89}"
	  Scope="perMachine">
	  
    <MajorUpgrade
		DowngradeErrorMessage="!(loc.DowngradeError)" />

	  <ui:WixUI Id="WixUI_MinimalUpgrade" />
	  <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Icon Id="ProductIcon" SourceFile="..\mde\images\mde.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />

    <!-- cabファイルを外部ファイルとして出力せず、.msiファイルに埋め込む -->
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main">
      <ComponentGroupRef Id="mde" />
    </Feature>
  </Package>
</Wix>
