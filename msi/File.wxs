<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="mde" Directory="INSTALLFOLDER">

		<!-- Application -->
		<Component Id="mde.exe.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="mde.exe" KeyPath="yes" /></Component>
		<Component Id="mde.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="mde.dll" KeyPath="yes" /></Component>
		<Component Id="mde.dll.runtimeconfig.json.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="mde.runtimeconfig.json" KeyPath="yes" /></Component>
		<Component Id="mde.dll.deps.json.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="mde.deps.json" KeyPath="yes" /></Component>

		<!-- PDF書き出し（headless Chromium）用のPuppeteerSharpと、その依存DLL。
		     Chromium本体は同梱せず、初回のPDF書き出し時にPuppeteerSharpが自動でダウンロードする
		     （ChromiumBrowserPool.cs参照）ため、ここではmde.csprojのビルド出力に含まれる
		     マネージドDLLのみを同梱する。 -->
		<Component Id="PuppeteerSharp.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="PuppeteerSharp.dll" KeyPath="yes" /></Component>
		<Component Id="Microsoft.Extensions.Logging.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="Microsoft.Extensions.Logging.dll" KeyPath="yes" /></Component>
		<Component Id="Microsoft.Extensions.Logging.Abstractions.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="Microsoft.Extensions.Logging.Abstractions.dll" KeyPath="yes" /></Component>
		<Component Id="Microsoft.Extensions.DependencyInjection.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="Microsoft.Extensions.DependencyInjection.dll" KeyPath="yes" /></Component>
		<Component Id="Microsoft.Extensions.DependencyInjection.Abstractions.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="Microsoft.Extensions.DependencyInjection.Abstractions.dll" KeyPath="yes" /></Component>
		<Component Id="Microsoft.Extensions.Options.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="Microsoft.Extensions.Options.dll" KeyPath="yes" /></Component>
		<Component Id="Microsoft.Extensions.Primitives.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="Microsoft.Extensions.Primitives.dll" KeyPath="yes" /></Component>
		<Component Id="Microsoft.IO.RecyclableMemoryStream.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="Microsoft.IO.RecyclableMemoryStream.dll" KeyPath="yes" /></Component>
		<Component Id="ReactiveExtensionsSharp.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="ReactiveExtensionsSharp.dll" KeyPath="yes" /></Component>
		<Component Id="WebDriverBiDi.dll.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="WebDriverBiDi.dll" KeyPath="yes" /></Component>

		<!-- License -->
		<Component Id="License"><File Source="LICENSE.txt" /></Component>

		<!-- サードパーティライブラリ（PuppeteerSharp等、上記参照）のライセンス表示 -->
		<Component Id="ThirdPartyNotices"><File Source="THIRD-PARTY-NOTICES.txt" /></Component>

		<!-- Readme（ヘルプ→「Readmeを開く」で開く。mde.csprojのビルド設定により、ビルド出力
		     フォルダ（mde.exe等と同じ場所）へコピーされたものをそのまま同梱する）。 -->
		<Component Id="Readme.md.Component" Directory="INSTALLFOLDER" Guid="*"><File Source="README.md" /></Component>

		<!-- Readmeが参照する画像（imagesフォルダ、中身ごと）。mde.csproj側は"images\**"で
		     フォルダごとまとめてコピーする設定になっているが、MSI側は１ファイルずつ明示的に
		     列挙する必要があるため、imagesフォルダに新しい画像を追加した場合はここにも
		     対応するComponentの追加が必要。 -->
		<Component Id="Images.ScreenLayout.png.Component" Directory="ImagesFolder" Guid="*"><File Source="images\screen_layout.png" /></Component>

		<!-- スタートメニューショートカット -->
		<Component Id="StartMenuShortcutComponent" Directory="ProgramMenuDir" Guid="*">
			<Shortcut Id="StartMenuShortcut" Name="mde" Target="[INSTALLFOLDER]mde.exe" WorkingDirectory="INSTALLFOLDER" >
				<ShortcutProperty Key="System.AppUserModel.ID" Value="tanno-seiichi.mde"/>
			</Shortcut>

			<RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
        
			<RegistryValue Root="HKCU" Key="Software\tanno-seiichi\mde" Name="StartMenu" Type="integer" Value="1" KeyPath="yes"/>
		</Component>		

	</ComponentGroup>
  </Fragment>
</Wix>
