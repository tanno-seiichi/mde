<Window x:Class="mde.LineHeightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="行間の設定"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Yu Gothic UI"
        FontSize="13"
        Background="{StaticResource PaperBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="行間（行の高さ）を設定してください" Margin="0,0,0,16"
                   Foreground="{StaticResource InkBrush}" FontWeight="Bold"/>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="m_slider" Grid.Column="0" Minimum="16" Maximum="48"
                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                    Margin="0,0,10,0"/>
            <TextBox x:Name="m_valueBox" Grid.Column="1" Padding="6,4" TextAlignment="Right"/>
        </Grid>

        <TextBlock Text="標準は26です。数値が小さいほど、一度に表示できる行数が増えます。"
                   Foreground="{StaticResource InkSoftBrush}" FontSize="12" Margin="0,0,0,14"
                   TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="既定値に戻す" Width="100" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource ToolbarButton}" Click="ResetClick"/>
            <Button Content="キャンセル" Width="84" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource ToolbarButton}" Click="CancelClick"/>
            <Button Content="OK" Width="84" Height="30" IsDefault="True"
                    Style="{StaticResource ToolbarButton}" Click="OkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
