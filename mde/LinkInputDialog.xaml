<Window x:Class="mde.LinkInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="リンク"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{StaticResource PaperBrush}">
    <StackPanel Margin="22">
        <TextBlock x:Name="m_titleText" Text="リンク先のURLを入力してください" Margin="0,0,0,16"
                   Foreground="{StaticResource InkBrush}" FontWeight="Bold"/>

        <TextBlock Text="URL" Margin="0,0,0,4"
                   Foreground="{StaticResource InkSoftBrush}" FontSize="12"/>
        <TextBox x:Name="m_urlBox" Margin="0,0,0,14" Padding="6,4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" Width="84" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource ToolbarButton}" Click="CancelClick"/>
            <Button Content="OK" Width="84" Height="30" IsDefault="True"
                    Style="{StaticResource ToolbarButton}" Click="OkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
