<Application x:Class="mde.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:mde.common"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
        <!-- メニュー・スクロールバーの見た目（mdew と同じ。MenuStyles.xaml・ScrollBarStyles.xaml） -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="MenuStyles.xaml"/>
            <ResourceDictionary Source="ScrollBarStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <SolidColorBrush x:Key="PaperBrush" Color="#FAF9F5"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ListPaneBrush" Color="#FCFDFF"/>
        <SolidColorBrush x:Key="ThinBorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="InkBrush" Color="#252220"/>
        <SolidColorBrush x:Key="InkSoftBrush" Color="#6F6A5F"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E3DDCC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6A63"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5EFEC"/>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- タスクリストのチェックボックス用スタイル。既定のCheckBoxはOSテーマに応じて
             未チェック時の内側がグレーで塗りつぶされるため、枠と白い背景だけの単純な
             見た目に差し替える。チェック時は、mdew（Chromium のチェックボックス）と同じく、
             角の丸い青色（#0075FF）の四角に白いチェックマークを表示する。チェック時の絵は、
             なめらかに描いたビットマップ（common\TaskCheckboxImages.cs）を高画質で縮小し、画面のピクセルの
             境目に合わせて表示する（PixelSnappedImage。編集ペインの文書は、なめらかに描く処理を止めているため、
             線（Path）で描くとギザギザになる）。
             BlockStyles.CreateTaskCheckboxからTag="task-checkbox"のチェックボックスにのみ
             適用され、ダイアログ内の通常のCheckBox（例：ColumnWidthDialogの「自動計算」）
             には影響しない。 -->
        <Style x:Key="TaskCheckboxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Box"
                                    Background="White"
                                    BorderBrush="#B0B0B0"
                                    BorderThickness="1.3"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True"/>
                            <common:PixelSnappedImage x:Name="CheckedImage"
                                   Source="{x:Static common:TaskCheckboxImages.CheckedImage}"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="CheckedImage" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
