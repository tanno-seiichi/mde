<Window x:Class="mde.PdfMarginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDFの余白を設定"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Yu Gothic UI"
        FontSize="13"
        Background="{StaticResource PaperBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="PDFに書き出す際の、上下左右の余白（px）を設定してください" Margin="0,0,0,16"
                   Foreground="{StaticResource InkBrush}" FontWeight="Bold" TextWrapping="Wrap"/>

        <TextBlock Text="上の余白" Margin="0,0,0,4"
                   Foreground="{StaticResource InkSoftBrush}" FontSize="12"/>
        <TextBox x:Name="m_topBox" Margin="0,0,0,14" Padding="6,4"/>

        <TextBlock Text="下の余白" Margin="0,0,0,4"
                   Foreground="{StaticResource InkSoftBrush}" FontSize="12"/>
        <TextBox x:Name="m_bottomBox" Margin="0,0,0,14" Padding="6,4"/>

        <TextBlock Text="左の余白" Margin="0,0,0,4"
                   Foreground="{StaticResource InkSoftBrush}" FontSize="12"/>
        <TextBox x:Name="m_leftBox" Margin="0,0,0,14" Padding="6,4"/>

        <TextBlock Text="右の余白" Margin="0,0,0,4"
                   Foreground="{StaticResource InkSoftBrush}" FontSize="12"/>
        <TextBox x:Name="m_rightBox" Margin="0,0,0,22" Padding="6,4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="既定値に戻す" Width="100" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource ToolbarButton}" Click="ResetClick"/>
            <Button Content="キャンセル" Width="84" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource ToolbarButton}" Click="CancelClick"/>
            <Button Content="OK" Width="84" Height="30" IsDefault="True"
                    Style="{StaticResource ToolbarButton}" Click="OkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
