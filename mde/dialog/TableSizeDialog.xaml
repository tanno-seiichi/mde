<Window x:Class="mde.dialog.TableSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:mde.common"
        Title="表を挿入" common:Loc.En="Insert Table"
        Width="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="12"
        Background="#FFFFFF">
    <!-- 部品（ボタン・入力欄・チェックボックス等）の見た目は、Windows のメッセージボックスと統一感が出るよう、
         Windows 11 風のもの（dialog\DialogStyles.xaml）にする。ボタンの間隔・幅は各ボタンに直接書く
         （ここにボタンの Style を足して BasedOn で引き継ごうとすると、WPF の既定の見た目を引き継いでしまうため） -->
    <Window.Resources>
        <ResourceDictionary Source="/mde;component/dialog/DialogStyles.xaml"/>
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="表のサイズを指定してください" common:Loc.En="Specify the size of the table" Margin="0,0,0,16"
                   Foreground="#1C1C1C" FontWeight="Bold"/>

        <TextBlock Text="行数（見出し行を含む）" common:Loc.En="Rows (including the header row)" Margin="0,0,0,4"
                   Foreground="#555555" FontSize="12"/>
        <TextBox x:Name="m_rowsBox" Text="3" Margin="0,0,0,14" Padding="6,4"/>

        <TextBlock Text="列数" common:Loc.En="Columns" Margin="0,0,0,4"
                   Foreground="#555555" FontSize="12"/>
        <TextBox x:Name="m_colsBox" Text="3" Margin="0,0,0,22" Padding="6,4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" common:Loc.En="Cancel" MinWidth="84" Margin="0,0,8,0" Click="CancelClick"/>
            <Button Content="挿入" common:Loc.En="Insert" MinWidth="84" IsDefault="True" Click="OkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
