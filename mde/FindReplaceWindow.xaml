<Window x:Class="mde.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="検索と置換"
        Width="550"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Yu Gothic UI"
        FontSize="13"
        Background="{StaticResource PaperBrush}">
    <StackPanel Margin="22">

        <TextBlock Text="検索する文字列" Margin="0,0,0,4" Foreground="{StaticResource InkSoftBrush}" FontSize="12"/>
        <TextBox x:Name="SearchBox" Padding="6,4" Margin="0,0,0,12" FontFamily="Consolas"/>

        <TextBlock Text="置換後の文字列" Margin="0,0,0,4" Foreground="{StaticResource InkSoftBrush}" FontSize="12"/>
        <TextBox x:Name="ReplaceBox" Padding="6,4" Margin="0,0,0,14" FontFamily="Consolas"/>

        <TextBlock Text="対象範囲" Margin="0,0,0,6" Foreground="{StaticResource InkSoftBrush}" FontSize="12"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="ScopeCurrentFile" Content="現在のファイル" GroupName="scope" IsChecked="True" VerticalAlignment="Center"/>
            <RadioButton x:Name="ScopeFolder" Content="フォルダ全体（サブフォルダ含む）" GroupName="scope" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <CheckBox x:Name="CaseSensitiveBox" Content="大文字・小文字を区別する"/>
            <CheckBox x:Name="UseRegexBox" Content="正規表現を使用する" Margin="20,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <Button Content="次を検索" Width="86" Style="{StaticResource ToolbarButton}" Click="FindNext_Click"/>
            <Button Content="すべて検索" Width="86" Style="{StaticResource ToolbarButton}" Click="FindAll_Click"/>
            <Button Content="すべて置換" Width="86" Style="{StaticResource ToolbarButton}" Click="ReplaceAll_Click"/>
            <Button Content="1件ずつ置換…" Width="100" Style="{StaticResource ToolbarButton}" Click="StepReplace_Click"/>
            <Button Content="閉じる" Width="70" Style="{StaticResource ToolbarButton}" Click="Close_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource InkSoftBrush}"/>

        <ListBox x:Name="ResultsList" Margin="0,8,0,0" MaxHeight="200" Visibility="Collapsed"
                 MouseDoubleClick="ResultsList_MouseDoubleClick" FontFamily="Consolas" FontSize="12"/>

        <!-- Step-by-step (one match at a time) session panel -->
        <Border x:Name="StepPanel" Visibility="Collapsed" Margin="0,14,0,0" Padding="14"
                Background="{StaticResource AccentSoftBrush}" CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="StepFileText" FontSize="11" FontFamily="Consolas"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <TextBlock x:Name="StepContextText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Content="置換" Width="80" Style="{StaticResource ToolbarButton}" Click="StepReplaceOne_Click"/>
                    <Button Content="スキップ" Width="80" Style="{StaticResource ToolbarButton}" Click="StepSkip_Click"/>
                    <Button Content="残りをすべて置換" Width="120" Style="{StaticResource ToolbarButton}" Click="StepReplaceRemaining_Click"/>
                    <Button Content="終了" Width="70" Style="{StaticResource ToolbarButton}" Click="StepEnd_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

    </StackPanel>
</Window>
