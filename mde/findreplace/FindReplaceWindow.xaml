<Window x:Class="mde.findreplace.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="検索と置換"
        Width="550"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="12"
        Background="#FFFFFF"
        PreviewKeyDown="FindReplaceWindowPreviewKeyDown">
    <!-- 部品（ボタン・入力欄・チェックボックス等）の見た目は、Windows のメッセージボックスと統一感が出るよう、
         Windows 11 風のもの（dialog\DialogStyles.xaml）にする。ボタンの間隔・幅は各ボタンに直接書く
         （ここにボタンの Style を足して BasedOn で引き継ごうとすると、WPF の既定の見た目を引き継いでしまうため） -->
    <Window.Resources>
        <ResourceDictionary Source="/mde;component/dialog/DialogStyles.xaml"/>
    </Window.Resources>
    <!-- 結果の一覧（m_resultsList）は、ウィンドウの大きさを変えた時に一緒に伸び縮みするよう、残りの高さ全部（2行目の *）を使う。
         ウィンドウを開いた時・結果を表示した時は、中身に合わせた高さ（SizeToContent="Height"。一覧は MaxHeight まで）になる -->
    <Grid Margin="22,22,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="検索する文字列" Margin="0,0,0,0"/>
            <TextBox x:Name="m_searchBox" Padding="6,4" Margin="0,4,0,12" FontFamily="Consolas"/>

            <Expander x:Name="m_replaceExpander" Header="置換後の文字列" Margin="0,0,0,14"
                      Expanded="ReplaceExpanderToggled" Collapsed="ReplaceExpanderToggled">
                <TextBox x:Name="m_replaceBox" Padding="6,4" Margin="0,2,0,0" FontFamily="Consolas"/>
            </Expander>

            <TextBlock Text="対象範囲" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="m_scopeCurrentFile" Content="現在のファイル" GroupName="scope" IsChecked="True" VerticalAlignment="Center"/>
                <RadioButton x:Name="m_scopeFolder" Content="フォルダ全体（サブフォルダ含む）" GroupName="scope" Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox x:Name="m_caseSensitiveBox" Content="大文字・小文字を区別する"/>
                <CheckBox x:Name="m_useRegexBox" Content="正規表現を使用する" Margin="20,0,0,0"/>
            </StackPanel>

            <WrapPanel>
                <Button Content="前を検索" MinWidth="86" Margin="0,0,8,8" Click="FindPreviousClick"/>
                <Button Content="次を検索" MinWidth="86" Margin="0,0,8,8" Click="FindNextClick"/>
                <Button Content="すべて検索" MinWidth="86" Margin="0,0,8,8" Click="FindAllClick" IsDefault="True"/>
                <Button x:Name="m_stepReplaceButton" Content="1件ずつ置換…" MinWidth="100" Margin="0,0,8,8"
                        Click="StepReplaceClick" Visibility="Collapsed"/>
                <Button x:Name="m_replaceAllButton" Content="すべて置換" MinWidth="86" Margin="0,0,8,8"
                        Click="ReplaceAllClick" Visibility="Collapsed"/>
            </WrapPanel>

            <TextBlock x:Name="m_statusText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"
                       Foreground="#666666"/>
        </StackPanel>

        <ListBox x:Name="m_resultsList" Grid.Row="1" Margin="0,8,0,20" MaxHeight="500" MinHeight="60" Visibility="Collapsed"
                 MouseDoubleClick="ResultsListMouseDoubleClick" FontFamily="Consolas" FontSize="12"/>

        <!-- Step-by-step (one match at a time) session panel -->
        <Border x:Name="m_stepPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,14,0,0" Padding="14"
                Background="#EEF4FB" BorderBrush="#C8DCF0" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="m_stepFileText" FontSize="11" FontFamily="Consolas"
                           Foreground="#0B62C4" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <TextBlock x:Name="m_stepContextText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           Foreground="#1C1C1C" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Content="置換" MinWidth="80" Margin="0,0,8,8" Click="StepReplaceOneClick"/>
                    <Button Content="スキップ" MinWidth="80" Margin="0,0,8,8" Click="StepSkipClick"/>
                    <Button Content="残りをすべて置換" MinWidth="120" Margin="0,0,8,8" Click="StepReplaceRemainingClick"/>
                    <Button Content="終了" MinWidth="70" Margin="0,0,8,8" Click="StepEndClick"/>
                </WrapPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>
