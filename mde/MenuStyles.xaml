<!-- mde：メニューの見た目（mdew の WebMenu.xaml・app.css のメニューバーと同じ見た目）。App.xaml で読み込み、
     メニューバー（MainWindow.xaml の Menu）・メニューバーのメニュー・右クリックのメニュー（ContextMenu）の全部に使う。

     メニューバー：背景は白・枠線なし・文字は Yu Gothic UI の 12px。項目は余白（上下 1px・左右 6px）だけのボタンで、
     マウスを乗せた時・メニューを開いている間は淡い灰色（角丸 2px）。
     メニュー：白い背景・灰色の枠（角丸 6px）・影、文字は Yu Gothic UI の 13px、項目の余白は上下 5px・左 6px・右 16px、
     左にチェックの印の欄（18px、青の ✓）、右にショートカット（灰色の 12px）・サブメニューの印（▸）、マウスを乗せた・
     矢印キーで選んだ項目は淡い青、使えない項目は灰色、区切り線は淡い灰色、見出し（MenuHeading）は灰色の 12px。

     影を描く分、メニューの外側に透明な余白（12px）を取る。開く位置は、この余白の分ずらしてある。
     文字の色（MenuText）は、メニュー「表示」→「文字の色」で置き換える（MainWindow.ApplyTextColor）。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:mde.common">

    <SolidColorBrush x:Key="MenuText" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="MenuBorder" Color="#C8CCD1"/>
    <SolidColorBrush x:Key="MenuHighlight" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="MenuBarHighlight" Color="#E6E8EB"/>
    <SolidColorBrush x:Key="MenuCheck" Color="#0B62C4"/>
    <SolidColorBrush x:Key="MenuSub" Color="#888888"/>
    <SolidColorBrush x:Key="MenuDisabled" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="MenuDisabledSub" Color="#BBBBBB"/>
    <SolidColorBrush x:Key="MenuSeparatorLine" Color="#E3E5E8"/>
    <FontFamily x:Key="MenuFont">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>

    <!-- メニューの枠（影・白い背景・灰色の枠・角丸）。メニューバーのメニュー・サブメニュー・右クリックのメニューで使う -->
    <ControlTemplate x:Key="MenuPanel" TargetType="ContentControl">
        <Grid Margin="12">
            <!-- 影（枠と同じ形の要素に付ける。中身に付けると文字がぼやけるため） -->
            <Border Background="White" CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.15"/>
                </Border.Effect>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1" CornerRadius="6"
                    Padding="0,4" MinWidth="160">
                <!-- 項目が入りきらない時のスクロール。キー操作は受け取らない（←→ キーでメニューバーの隣のメニューへ
                     移れるように。common\MenuScrollViewer.cs） -->
                <common:MenuScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ContentPresenter/>
                </common:MenuScrollViewer>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- 右クリックのメニュー。マウスの位置に枠の左上が来るよう、影の余白の分ずらす -->
    <Style TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="HorizontalOffset" Value="-12"/>
        <Setter Property="VerticalOffset" Value="-12"/>
        <Setter Property="FontFamily" Value="{StaticResource MenuFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <ContentControl Template="{StaticResource MenuPanel}" Focusable="False">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- メニューバーの項目（メニューを持つもの：「ファイル」「表示」「ヘルプ」）。メニューは項目の左端・2px 下に開く
         （横：-12（影の余白）、縦：2 - 12（影の余白）= -10） -->
    <ControlTemplate x:Key="MenuBarHeaderTemplate" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="6,1" SnapsToDevicePixels="True">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-12" VerticalOffset="-10"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                <ContentControl Template="{StaticResource MenuPanel}" Focusable="False"
                                FontFamily="{StaticResource MenuFont}" FontSize="13">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                    KeyboardNavigation.TabNavigation="Cycle"/>
                </ContentControl>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuBarHighlight}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuBarHighlight}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource MenuDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- メニューバーの項目（メニューを持たないもの：「検索と置換」） -->
    <ControlTemplate x:Key="MenuBarItemTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="6,1" SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuBarHighlight}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource MenuDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- メニューの項目（サブメニューを持たないもの） -->
    <ControlTemplate x:Key="MenuItemTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" Padding="6,5,16,5" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Check" Text="✓" Foreground="{StaticResource MenuCheck}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Hidden"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0"
                           Foreground="{StaticResource MenuSub}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHighlight}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource MenuDisabled}"/>
                <Setter TargetName="Gesture" Property="Foreground" Value="{StaticResource MenuDisabledSub}"/>
                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- サブメニューを持つ項目（右側に ▸。サブメニューは項目の右に、親のメニューと 2px 重ねて開く。右に収まらなければ左に開く）。
         開く位置の基準のこの Grid は、項目の右の余白（16px）・上の余白（5px）の内側。サブメニューの外側には影の余白（12px）がある。
         横：16（右の余白）+ 1（親の枠）- 2（重ね）- 12（影の余白）= 3、縦：-5（上の余白）- 5 - 12（影の余白）= -22 -->
    <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" Padding="6,5,16,5" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Check" Text="✓" Foreground="{StaticResource MenuCheck}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Hidden"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="Arrow" Grid.Column="2" Text="▸" Margin="28,0,0,0" Foreground="{StaticResource MenuSub}"
                           FontSize="12" VerticalAlignment="Center"/>
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="3" VerticalOffset="-22"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                    <ContentControl Template="{StaticResource MenuPanel}" Focusable="False">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                        KeyboardNavigation.TabNavigation="Cycle"/>
                    </ContentControl>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHighlight}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHighlight}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource MenuDisabled}"/>
                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource MenuDisabledSub}"/>
                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- メニューの項目（すべての MenuItem に使う。メニューバーの項目か、メニューの中の項目かで見た目を変える） -->
    <Style TargetType="MenuItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
        <Setter Property="Template" Value="{StaticResource MenuItemTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuBarHeaderTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuBarItemTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 選べない見出し（下の項目のまとまりの名前。「表示倍率：100%」等） -->
    <Style x:Key="MenuHeading" TargetType="MenuItem">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <TextBlock Text="{TemplateBinding Header}" Padding="10,4,16,2" FontSize="12"
                               Foreground="{StaticResource MenuSub}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 区切り線（メニューの中の Separator） -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="0,4" Background="{StaticResource MenuSeparatorLine}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
