<Window x:Class="mde.TableSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表を挿入"
        Width="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{StaticResource PaperBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="表のサイズを指定してください" Margin="0,0,0,16"
                   Foreground="{StaticResource InkBrush}" FontWeight="Bold"/>

        <TextBlock Text="行数（見出し行を含む）" Margin="0,0,0,4"
                   Foreground="{StaticResource InkSoftBrush}" FontSize="12"/>
        <TextBox x:Name="m_rowsBox" Text="3" Margin="0,0,0,14" Padding="6,4"/>

        <TextBlock Text="列数" Margin="0,0,0,4"
                   Foreground="{StaticResource InkSoftBrush}" FontSize="12"/>
        <TextBox x:Name="m_colsBox" Text="3" Margin="0,0,0,22" Padding="6,4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" Width="84" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource ToolbarButton}" Click="CancelClick"/>
            <Button Content="挿入" Width="84" Height="30" IsDefault="True"
                    Style="{StaticResource ToolbarButton}" Click="OkClick"/>
        </StackPanel>
    </StackPanel>
</Window>
