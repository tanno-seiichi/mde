<Window x:Class="mde.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="mde"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Height="860" Width="1240"
        FontFamily="Segoe UI, Yu Gothic UI"
        Background="{StaticResource CardBrush}"
        PreviewKeyDown="MainWindowPreviewKeyDown"
        Closing="WindowClosing">

    <Window.Resources>
        <sys:Double x:Key="EditorLineHeight">26</sys:Double>
        <!-- 段落・リスト・表どうしの間の余白（ApplyEditorLineHeight参照）は、行間
             （EditorLineHeight）の値に関わらず常にこの固定値のままにする（段落内の行間と
             二重に加算されて、行間の設定値を上げるほど間隔が不自然に広がるのを防ぐため。
             DESIGN.md 14.11節参照）。ゼロにはしない：見出し・コードブロック・水平線は
             それぞれ固有のMarginを明示的に持っているのに対し、通常の段落・リスト・表は
             この共有の値だけを頼りにしているため、ここが0だと、空行区切りのMarkdown段落
             どうしが単純な行の折り返しと見分けが付かなくなってしまう。ここでの初期値も
             それに合わせておく（実際にはMainWindowコンストラクタのApplyEditorLineHeight
             呼び出しで、起動直後にこの値で上書きされる）。 -->
        <Thickness x:Key="EditorBlockSpacing">0,0,0,14</Thickness>
        <Style TargetType="MenuItem" x:Key="CtxMenuItem">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Button" x:Key="ZoomButton" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="2,3"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ===================== Menu bar ===================== -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource CardBrush}" Foreground="{StaticResource InkBrush}"
              BorderBrush="{StaticResource ThinBorderBrush}" BorderThickness="0,0,0,1" Padding="6,3" FontSize="13">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規作成(_N)" Click="NewBtnClick" InputGestureText="Ctrl+N"/>
                <MenuItem Header="新しいウインドウ" Click="NewWindowClick" InputGestureText="Shift+Ctrl+N"/>
                <MenuItem Header="開く…(_O)" Click="OpenBtnClick" InputGestureText="Ctrl+O"/>
                <MenuItem x:Name="m_recentFilesMenu" Header="最近使ったファイル(_R)"/>
                <MenuItem Header="保存(_S)" Click="SaveBtnClick" InputGestureText="Ctrl+S"/>
                <MenuItem Header="名前を付けて保存…" Click="SaveAsBtnClick" InputGestureText="Shift+Ctrl+S"/>
                <MenuItem Header="すべて保存(_A)" Click="SaveAllBtnClick"/>
                <Separator/>
                <MenuItem Header="PDFに書き出し…(_P)" Click="ExportPdfBtnClick" InputGestureText="Ctrl+P"/>
                <MenuItem Header="PDFの余白を設定…(_M)" Click="PdfMarginBtnClick"/>
                <Separator/>
                <MenuItem Header="閉じる(_W)" Click="CloseBtnClick" InputGestureText="Ctrl+W"/>
            </MenuItem>
            <MenuItem Header="検索と置換(_F)" Click="FindReplaceBtnClick" InputGestureText="Ctrl+F"/>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="行間を設定…(_L)" Click="LineHeightBtnClick"/>
                <Separator/>
                <MenuItem Header="リンクの開き方">
                    <MenuItem x:Name="m_linkModeCtrlClickMenuItem" Header="Ctrl+クリックで開く(_C)"
                              IsCheckable="True" Click="LinkModeCtrlClickChecked"/>
                    <MenuItem x:Name="m_linkModeClickOnlyMenuItem" Header="クリックのみで開く(_O)"
                              IsCheckable="True" Click="LinkModeClickOnlyChecked"/>
                </MenuItem>
                <MenuItem Header="段落中の改行">
                    <MenuItem x:Name="m_lineBreakModeSourceMenuItem" Header="ソースの通りに改行する(_S)"
                              IsCheckable="True" Click="LineBreakModeSourceChecked"/>
                    <MenuItem x:Name="m_lineBreakModeBlankOnlyMenuItem" Header="空行が入るまで改行しない(_B)"
                              IsCheckable="True" Click="LineBreakModeBlankOnlyChecked"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="m_debugLogMenuItem" Header="デバッグログを有効にする(_D)"
                          IsCheckable="True" Click="DebugLogMenuItemChecked"/>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="Readmeを開く(_R)" Click="OpenReadmeBtnClick"/>
                <Separator/>
                <MenuItem Header="バージョン情報(_A)" Click="VersionInfoBtnClick"/>
            </MenuItem>
        </Menu>

        <!-- ===================== Status bar (panes / zoom / mode) ===================== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource ThinBorderBrush}" BorderThickness="0,1,0,0"
                Padding="4,1,2,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="m_toggleFolderPaneBtn" Content="フォルダを隠す" Style="{StaticResource ToolbarButton}" Click="ToggleFolderPaneBtnClick"/>
                    <Button x:Name="m_toggleOutlinePaneBtn" Content="アウトラインを隠す" Style="{StaticResource ToolbarButton}" Click="ToggleOutlinePaneBtnClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="m_toggleModeBtn" Content="ソースモードに切替" Style="{StaticResource ToolbarButton}" Click="ToggleModeBtnClick"/>

                    <Grid Width="30" />

                    <Button Content="－" Style="{StaticResource ZoomButton}" Click="ZoomOutClick"/>
                    <Button x:Name="m_zoomLabelBtn" Content="100%" Width="Auto" Style="{StaticResource ToolbarButton}"
                            Click="ZoomResetClick"/>
                    <Button Content="＋" Style="{StaticResource ZoomButton}" Click="ZoomInClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Body: folder | outline | editor ===================== -->
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="m_folderColumnDef" Width="190"/>
                <ColumnDefinition x:Name="m_folderSplitterColumnDef" Width="2"/>
                <ColumnDefinition x:Name="m_outlineColumnDef" Width="210"/>
                <ColumnDefinition x:Name="m_outlineSplitterColumnDef" Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==== Folder pane ==== -->
            <Border x:Name="m_folderPaneBorder" Grid.Column="0" Background="{StaticResource ListPaneBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,0" CornerRadius="0">
                <DockPanel Margin="0,0,0,0">
                    <Grid DockPanel.Dock="Top" Margin="8,8,4,6">
                        <TextBlock Text="フォルダ" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkBrush}"/>
                        <Button Content="…" Width="24" Height="22" HorizontalAlignment="Right"
                                Style="{StaticResource ToolbarButton}" Margin="0" Padding="0"
                                Click="OpenFolderTreeBtnClick"/>
                    </Grid>
                    <TreeView x:Name="m_folderTree" BorderThickness="0" Background="Transparent"
                              Loaded="FolderTreeLoaded"
                              SelectedItemChanged="FolderTreeSelectedItemChanged">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <EventSetter Event="Expanded" Handler="TreeViewItemExpanded"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border x:Name="m_matchHighlightBorder" CornerRadius="3" Padding="3,1"
                                        BorderThickness="1,1,1,1" BorderBrush="Transparent" Margin="-1,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource InkBrush}"/>
                                </Border>
                                <HierarchicalDataTemplate.Triggers>
                                    <!-- 選択中(IsSelected)・検索一致(IsSearchMatch)は同時に成立しうる
                                         組み合わせで、どちらもBackgroundを取り合うと片方の情報が
                                         見えなくなる（DEVELOPMENT_LOG.md 14.7参照）。選択は枠線
                                         （BorderBrush）、検索一致は背景色（Background）と、別々の
                                         プロパティで表現することで両立させる。「選択中だが検索一致
                                         ではない」場合だけ、従来どおりの塗りつぶし背景も付ける
                                         （単なる選択だけでも見やすいように）。 -->
                                    <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                        <Setter TargetName="m_matchHighlightBorder" Property="Background" Value="#FFE166"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="m_matchHighlightBorder" Property="BorderBrush" Value="#26A0DA"/>
                                        <Setter TargetName="m_matchHighlightBorder" Property="CornerRadius" Value="0"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True"/>
                                            <Condition Binding="{Binding IsSearchMatch}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="m_matchHighlightBorder" Property="Background" Value="#CBE8F6"/>
                                    </MultiDataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="m_folderSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Width="1" Background="{StaticResource ThinBorderBrush}"/>

            <!-- ==== Outline pane ==== -->
            <Border x:Name="m_outlinePaneBorder" Grid.Column="2" Background="{StaticResource ListPaneBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,0" CornerRadius="0">
                <DockPanel Margin="0,0,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="アウトライン" FontWeight="Bold" FontSize="12"
                               Margin="8,8,8,6" Foreground="{StaticResource InkBrush}"/>
                    <!-- フォルダペイン（上のm_folderTree）と同じ構成のTreeView。横スクロールバーの
                         見た目・挙動（TextTrimmingを付けない、BringIntoView後に横スクロールだけ
                         0へ戻す等）もフォルダペインに合わせている。以前、アウトラインだけ
                         TextTrimming="CharacterEllipsis"を付けていた際に、長い見出しを選択した
                         瞬間だけ表示が一瞬崩れる不具合があったため（DEVELOPMENT_LOG.md参照）。 -->
                    <TreeView x:Name="m_outlineTree" BorderThickness="0" Background="Transparent"
                              Loaded="OutlineTreeLoaded"
                              SelectedItemChanged="OutlineTreeSelectedItemChanged">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <!-- 選択・フォーカスが変わるたびにWPF標準の動作で項目を横方向にも
                                     完全に見せようとスクロールしてしまう（見出しが長い場合、選択の
                                     たびに横スクロールバーが一瞬右へずれて戻る「ちらつき」の原因）。
                                     RequestBringIntoViewを横方向だけ無効化することで、そもそも
                                     この自動スクロールを起こさせないようにする（詳しい理由は
                                     OutlineTreeItemRequestBringIntoViewのコメント参照）。 -->
                                <EventSetter Event="RequestBringIntoView" Handler="OutlineTreeItemRequestBringIntoView"/>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Border x:Name="m_matchHighlightBorder" CornerRadius="3" Padding="3,1"
                                        BorderThickness="1,1,1,1" BorderBrush="Transparent" Margin="-1,0,0,0">
                                    <TextBlock Text="{Binding Text}" FontSize="{Binding FontSizeValue}" Foreground="{StaticResource InkBrush}"/>
                                </Border>
                                <HierarchicalDataTemplate.Triggers>
                                    <!-- フォルダペインと同じ理由・同じ対策（DEVELOPMENT_LOG.md 14.7、
                                         MainWindow.xamlのm_folderTree側のコメント参照）。選択は
                                         枠線、検索一致は背景色と別プロパティにして両立させる。 -->
                                    <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                                        <Setter TargetName="m_matchHighlightBorder" Property="Background" Value="#FFE166"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="m_matchHighlightBorder" Property="BorderBrush" Value="#26A0DA"/>
                                        <Setter TargetName="m_matchHighlightBorder" Property="CornerRadius" Value="0"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True"/>
                                            <Condition Binding="{Binding IsSearchMatch}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="m_matchHighlightBorder" Property="Background" Value="#CBE8F6"/>
                                    </MultiDataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="m_outlineSplitter" Grid.Column="3" HorizontalAlignment="Stretch" Width="1" Background="{StaticResource ThinBorderBrush}"/>

            <!-- ==== Editor pane ==== -->
            <Border Grid.Column="4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,0" CornerRadius="0">
                <Grid>
                    <RichTextBox x:Name="m_editor"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="20,20,4,0"
                                 FontSize="16"
                                 SelectionBrush="#3390FF"
                                 SelectionOpacity="0.45"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsTab="True"
                                 SpellCheck.IsEnabled="False"
                                 TextChanged="EditorTextChanged"
                                 PreviewKeyDown="EditorPreviewKeyDown"
                                 PreviewTextInput="EditorPreviewTextInput"
                                 PreviewMouseWheel="EditorPreviewMouseWheel"
                                 PreviewMouseLeftButtonDown="EditorPreviewMouseLeftButtonDown"
                                 SizeChanged="EditorSizeChanged"
                                 AllowDrop="True"
                                 PreviewDragEnter="EditorDragEnter"
                                 PreviewDragOver="EditorDragOver"
                                 PreviewDrop="EditorDrop"
                                 ContextMenuOpening="EditorContextMenuOpening">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="{DynamicResource EditorBlockSpacing}"/>
                                <Setter Property="LineHeight" Value="{DynamicResource EditorLineHeight}"/>
                            </Style>
                            <Style TargetType="List">
                                <Setter Property="Margin" Value="{DynamicResource EditorBlockSpacing}"/>
                                <Setter Property="Padding" Value="32,0,0,0"/>
                                <!-- 以前はここでMarkerStyle=Circle/Squareの時だけList.FontSizeを
                                     小さくして、2段目以降の記号（○）をTyporaのように小さく
                                     見せていた。しかし、あるListItemが「自分の段落」と「さらに
                                     ネストした子List」の両方をBlocksに持つ状態になると（＝箇条書き
                                     の項目をTabでさらに字下げできる状態にすると）、その子Listに
                                     このFontSize縮小が効いているかどうかによって、なぜか親である
                                     自分自身の段落の文字まで異常に小さく表示されてしまうという、
                                     ネストの深さを問わず追いかけてくる副作用が実機で確認された
                                     （DESIGN.md 14.13参照）。安全のため、記号の縮小は一旦撤回し、
                                     WPF既定の大きさに戻している。 -->
                                <Style.Triggers>
                                    <Trigger Property="MarkerStyle" Value="Decimal">
                                        <Setter Property="Padding" Value="34,0,0,0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="Table">
                                <Setter Property="Margin" Value="{DynamicResource EditorBlockSpacing}"/>
                                <Setter Property="CellSpacing" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                        <RichTextBox.ContextMenu>
                            <ContextMenu x:Name="m_editorContextMenu">
                                <MenuItem x:Name="m_textStyleMenuItem" Header="文字装飾" Style="{StaticResource CtxMenuItem}"
                                          Visibility="Collapsed">
                                    <MenuItem Header="通常表記に戻す" Tag="normal" Click="TextStyleItemClick"/>
                                    <MenuItem Header="インラインコードにする" Tag="code" Click="TextStyleItemClick"/>
                                    <MenuItem Header="太字にする" Tag="bold" Click="TextStyleItemClick"/>
                                    <MenuItem Header="取り消し線にする" Tag="strikethrough" Click="TextStyleItemClick"/>
                                    <MenuItem Header="下線を引く" Tag="underline" Click="TextStyleItemClick"/>
                                    <MenuItem Header="ハイライトにする" Tag="highlight" Click="TextStyleItemClick"/>
                                    <MenuItem Header="リンクにする…" Tag="link" Click="TextStyleItemClick"/>
                                </MenuItem>
                                <MenuItem x:Name="m_linkMenuItem" Header="リンク" Style="{StaticResource CtxMenuItem}"
                                          Visibility="Collapsed">
                                    <MenuItem Header="リンクを開く" Click="LinkOpenClick"/>
                                    <MenuItem Header="URLをコピー" Click="LinkCopyUrlClick"/>
                                    <MenuItem Header="リンクを編集…" Click="LinkEditClick"/>
                                    <MenuItem Header="リンクを解除" Click="LinkRemoveClick"/>
                                </MenuItem>
                                <MenuItem x:Name="m_headingMenuItem" Header="見出し" Style="{StaticResource CtxMenuItem}">
                                    <MenuItem Header="本文（見出しなし）" Tag="0" IsCheckable="True" Click="HeadingItemClick"/>
                                    <MenuItem Header="# 見出し1" Tag="1" IsCheckable="True" Click="HeadingItemClick"/>
                                    <MenuItem Header="## 見出し2" Tag="2" IsCheckable="True" Click="HeadingItemClick"/>
                                    <MenuItem Header="### 見出し3" Tag="3" IsCheckable="True" Click="HeadingItemClick"/>
                                    <MenuItem Header="#### 見出し4" Tag="4" IsCheckable="True" Click="HeadingItemClick"/>
                                    <MenuItem Header="##### 見出し5" Tag="5" IsCheckable="True" Click="HeadingItemClick"/>
                                    <MenuItem Header="###### 見出し6" Tag="6" IsCheckable="True" Click="HeadingItemClick"/>
                                </MenuItem>
                                <MenuItem x:Name="m_insertTableMenuItem" Header="表を挿入" Style="{StaticResource CtxMenuItem}"
                                          Click="InsertTableItemClick"/>
                                <MenuItem x:Name="m_insertRowAboveMenuItem" Header="上に行を挿入" Style="{StaticResource CtxMenuItem}"
                                          Click="InsertRowAboveItemClick" Visibility="Collapsed"/>
                                <MenuItem x:Name="m_insertRowBelowMenuItem" Header="下に行を挿入" Style="{StaticResource CtxMenuItem}"
                                          Click="InsertRowBelowItemClick" Visibility="Collapsed"/>
                                <MenuItem x:Name="m_insertColumnLeftMenuItem" Header="左に列を挿入" Style="{StaticResource CtxMenuItem}"
                                          Click="InsertColumnLeftItemClick" Visibility="Collapsed"/>
                                <MenuItem x:Name="m_insertColumnRightMenuItem" Header="右に列を挿入" Style="{StaticResource CtxMenuItem}"
                                          Click="InsertColumnRightItemClick" Visibility="Collapsed"/>
                                <MenuItem x:Name="m_deleteRowMenuItem" Header="この行を削除" Style="{StaticResource CtxMenuItem}"
                                          Click="DeleteRowItemClick" Visibility="Collapsed"/>
                                <MenuItem x:Name="m_deleteColumnMenuItem" Header="この列を削除" Style="{StaticResource CtxMenuItem}"
                                          Click="DeleteColumnItemClick" Visibility="Collapsed"/>
                                <MenuItem x:Name="m_deleteTableMenuItem" Header="表を削除" Style="{StaticResource CtxMenuItem}"
                                          Click="DeleteTableItemClick" Visibility="Collapsed"/>
                                <MenuItem x:Name="m_copyCodeBlockMenuItem" Header="コードブロック全体をコピー（```込み）" Style="{StaticResource CtxMenuItem}"
                                          Click="CopyCodeBlockItemClick" Visibility="Collapsed"/>
                                <MenuItem x:Name="m_openImageMenuItem" Header="画像を開く" Style="{StaticResource CtxMenuItem}"
                                          Click="OpenImageItemClick" Visibility="Collapsed"/>
                                <MenuItem x:Name="m_saveImageMenuItem" Header="画像を保存…" Style="{StaticResource CtxMenuItem}"
                                          Click="SaveImageItemClick" Visibility="Collapsed"/>
                                <MenuItem x:Name="m_deleteImageMenuItem" Header="画像を削除" Style="{StaticResource CtxMenuItem}"
                                          Click="DeleteImageItemClick" Visibility="Collapsed"/>
                                <Separator/>
                                <MenuItem x:Name="m_toggleModeMenuItem" Header="ソースモードに切り替え"
                                          Style="{StaticResource CtxMenuItem}" Click="ToggleModeBtnClick"/>
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                        <FlowDocument x:Name="m_editorDocument" FontFamily="Yu Gothic UI, Segoe UI"/>
                    </RichTextBox>

                    <TextBox x:Name="m_sourceEditor"
                             Visibility="Collapsed"
                             BorderThickness="0"
                             Background="#F0F0F0"
                             Foreground="#000000"
                             Padding="40,32"
                             FontFamily="Segoe UI, Yu Gothic UI"
                             FontSize="16"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="SourceEditorTextChanged">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Markdownモードに切り替え" Click="ToggleModeBtnClick"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
