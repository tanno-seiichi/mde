<Window x:Class="mde.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mde"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Title="AboutWindow" Height="245" Width="255">
    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image x:Name="m_appIcon" Width="75" Height="75" Margin="0,12,0,15" Source="/images/mde.png"/>
        <Label x:Name="m_appTitle" HorizontalAlignment="Center" Padding="0" FontSize="15" Content="AppTitle"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Label FontSize="13" Padding="0" Content="Version"/>
            <Grid Width="5"/>
            <Label x:Name="m_appVersion" FontSize="13" Padding="0" Content="0.0.0.0"/>
        </StackPanel>
        <Grid Height="10"/>
        <Grid Height="2"/>
        <Label x:Name="m_appCopyright" HorizontalAlignment="Center" Padding="0" FontSize="11" Content="Copyright"/>
    </StackPanel>
</Window>
